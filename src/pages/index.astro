---
import MainLayout from "../pages/layouts/MainLayout.astro";
import Hero from "../pages/components/Hero.astro";
import Footer from "../pages/components/Footer.astro";
import Parallax from "../pages/components/Parallax.astro";
---
<MainLayout>
  <Hero />

  <section class="section" id="producte">
    <h2>La bebida que necesitas</h2>
    <p>Energía que impulsa tu día al máximo</p>

    <img src="/img/Lata verde.png" alt="Lata verde" class="product-img" />
    <img src="/img/Lata azul.png" alt="Lata azul" class="product-img" />
    <img src="/img/Lata Roja.png" alt="Lata roja" class="product-img" />
    <img src="/img/Lata amarilla.png" alt="Lata amarilla" class="product-img" />

    <a href="/producte" class="cta">Ver producto</a>
  </section>

  <Parallax />

  <section class="feature">
    <h2>Rendimiento al máximo</h2>

    <p>
      <strong>
        ThunderFuel está diseñado para llevar tu energía al siguiente nivel durante todo el día.
      </strong>
    </p>
  </section>

  <Footer />
</MainLayout>