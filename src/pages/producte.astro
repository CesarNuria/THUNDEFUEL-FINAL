---
import MainLayout from "../pages/layouts/MainLayout.astro"; 

const productos = [
  {
    nombre: "Extreme Power",
    sabor: "Clásico",
    precio: 2.00,
    volumen: "500ml",
    imagen: "/img/Lata amarilla.png",
    color: "#FFD700"
  },
  {
    nombre: "Watermelon Power",
    sabor: "Sandía",
    precio: 2.00,
    volumen: "500ml",
    imagen: "/img/Lata verde.png",
    color: "#4CAF50"
  },
  {
    nombre: "Strawberry Power",
    sabor: "Fresa",
    precio: 2.00,
    volumen: "500ml",
    imagen: "/img/Lata Roja.png",
    color: "#F44336"
  },
  {
    nombre: "Blueberry Power",
    sabor: "Arándano",
    precio: 2.00,
    volumen: "500ml",
    imagen: "/img/Lata azul.png",
    color: "#2196F3"
  }
];
---

<MainLayout>
  {productos.map((producto, index) => (
    <section class="seccion" style={`background:${producto.color}`}>
      <div class={`contenido ${index % 2 === 0 ? "izquierda" : "derecha"}`}>
        
        <img src={producto.imagen} alt={producto.nombre} />

        <div class="texto">
          <h1>{producto.nombre}</h1>
          <p>{producto.sabor} • {producto.volumen}</p>
          <p class="precio">{producto.precio.toFixed(2)}€</p>
          <button>Comprar</button>
        </div>

      </div>
    </section>
  ))}
</MainLayout>